{
  "config": {
    // Line length — Prettier handles wrapping
    "MD013": false,
    // Duplicate headings — legitimate in structured docs (repeated section names under different parents)
    "MD024": false,
    // Inline HTML — README uses HTML for badges, details/summary, image attributes
    "MD033": false,
    // Multiple consecutive blank lines — Prettier normalizes these
    "MD012": false,
    // Multiple top-level headings — some docs use multiple H1s or start with frontmatter
    "MD025": false,
    // First line must be a heading — files can start with frontmatter or non-heading content
    "MD041": false,
    // Table column style — tables use mixed alignment that the rule rejects
    "MD060": false,
  },
  "ignores": [
    // Auto-generated by the release workflow
    "CHANGELOG.md",
    // Generated via npm run generate:dockerhub-readme
    "DOCKERHUB.md",
    // Test fixtures, not user-facing docs
    "src/__tests__/**",
    // Bootstrap templates for new vaults
    "templates/**",
  ],
  "gitignore": true,
}
