#!/command/with-contenv sh
# MCP server longrun supervised by s6.
# The dependency on svc-obsidian-sync gates STARTUP ORDER only — s6-rc does
# not restart-couple longruns and does not wait for sync health. First-sync
# COMPLETION is guaranteed upstream: the init-first-sync oneshot runs
# `ob sync` to completion before either longrun starts, so on a fresh volume
# the vault reflects remote truth by the time the server's memory bootstrap
# runs (#440). Files arriving via later continuous sync self-heal — the file
# watcher indexes them as they land. The memory-write shrink guard is
# defense-in-depth for update/delete writes only; it does not cover
# bootstrap.
set -e

# s6 services do not inherit the Dockerfile WORKDIR; the server resolves
# dist/ and package.json relative to /app.
cd /app

# Setup mode (no working Sync token yet): serve the /setup sign-in page
# instead of the MCP server. The setup server exits 0 once the token file
# is written; the finish script beside this file then stops the container
# so the restart policy boots it again.
if [ "${SETUP_MODE:-}" = 1 ]; then
  exec s6-setuidgid obsidian node --enable-source-maps dist/src/vault-mcp/setup/setup-server.js
fi

exec s6-setuidgid obsidian node --enable-source-maps dist/src/vault-mcp/server.js
