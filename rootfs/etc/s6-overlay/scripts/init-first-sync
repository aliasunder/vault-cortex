#!/command/with-contenv sh
# shellcheck shell=sh # ShellCheck cannot read the with-contenv shebang
# One-shot first sync: run `ob sync` (no --continuous) to COMPLETION before
# svc-obsidian-sync and svc-vault-mcp start — otherwise the server boots
# against a still-empty vault, bootstraps default About Me/ templates, and
# bidirectional sync pushes them over the user's real memory files.
#
# Pre-sync guard: the sync engine keeps a per-device record of the files
# it holds locally and, at startup, pushes every recorded file that is
# missing from disk as a deletion. A non-empty record alongside a vault
# with no content means the vault volume was wiped while the device state
# was kept. The guard exits FATAL before any sync runs.
#
# Never-downloaded files: before each attempt, and once more after the last,
# the script queues every file the engine knows about but this device has no
# local record of, so widening a filter can't delete the files it kept out.
# - The engine records a filtered-out file in its copy of the server's file
#   list (server_files) without downloading it, so the file has no local
#   record (local_files).
# - The engine reads a server_files row with no local_files row as a file
#   deleted on this device, since a local deletion removes that record at
#   once. Its deletion scan then pushes that deletion to the server. A
#   never-downloaded file looks the same.
# - The engine queues newly allowed files itself (pending_files) when a
#   filter changes, but init-setup-vault's `ob sync-setup` resets the filter
#   to the default on every boot. The engine then compares the new value
#   against the default, not the previous boot's value, so a change back
#   toward the default (removing an excluded folder, re-adding a type)
#   queues nothing.
# - The script copies each such row into pending_files instead. The engine's
#   pending loop runs before the scan and downloads the file, or drops it if
#   the filter still excludes it.
# - A file another device adds reaches server_files only after it
#   downloads, so it never needs queuing.
# - A one-shot `ob sync` stops at the first failed download, before the scan,
#   so a failed first-sync attempt can't push deletions either.
#
# Failure policy once attempts are exhausted:
# - Files still queued for download and two-way sync: FATAL. Continuous sync
#   retries a failed download with a backoff and runs its deletion scan
#   meanwhile, so it would delete those files everywhere.
# - Memory enabled + memory folder missing + two-way sync: FATAL. Bootstrap
#   writes templates only when the folder is missing (fresh volume, or a
#   partial sync where the folder hasn't arrived), and two-way sync would
#   push them over the real files.
# - Otherwise: warn and continue. Bootstrap is a no-op, and continuous sync
#   keeps retrying.
# A FATAL exit stops the container (S6_BEHAVIOUR_IF_STAGE2_FAILS=2), and the
# restart policy owns the outer retry.
set -e

if [ "${SETUP_MODE:-}" = 1 ]; then
  echo "[obsidian-sync] Setup mode — skipping the first sync."
  exit 0
fi

VAULT_PATH="${VAULT_PATH:-/vault}"
if ! cd "$VAULT_PATH"; then
  echo "[obsidian-sync] ERROR: Failed to change directory to VAULT_PATH='$VAULT_PATH'." >&2
  exit 1
fi

# obsidian-headless keeps one SQLite store per configured vault:
# $XDG_CONFIG_HOME/obsidian-headless/sync/<vaultId>/state.db. Its
# local_files table is the record the engine compares against disk.
#
# The guard sums local_files across every store instead of resolving
# <vaultId>. The image serves one vault, so a second store exists only
# after the device was registered against a different remote vault
# (one deleted and re-created, or a manual sync-setup). Counting that
# store too keeps the guard conservative; the cost is a stopped
# container until the device is re-registered. The queue step below reads
# only the active store, because it writes to the store the client syncs from.
SYNC_STATE_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/obsidian-headless/sync"

# Prints the number of files the sync state records as present locally;
# 0 when no store exists yet (fresh device). A store that exists but
# cannot be read is a non-zero exit — the caller treats that as fatal
# rather than assuming the device is fresh.
# stdout is the return value: the caller captures it with $(...) and
# compares it as an integer, so the only output is the bare number.
known_sync_files() {
  set -- "$SYNC_STATE_ROOT"/*/state.db
  [ -e "$1" ] || { echo 0; return 0; }
  node --no-warnings -e '
    const { DatabaseSync } = require("node:sqlite")
    const storeCounts = process.argv.slice(1).map((file) => {
      const db = new DatabaseSync(file, { readOnly: true })
      // Only file rows count ("folder": false in the row data). Folder rows
      // survive a vault emptied of notes while the folders stay, and a
      // deleted folder is not what the guard protects against. A row that
      // says neither is counted, so an unexpected shape errs toward stopping.
      const { count } = db
        .prepare("SELECT COUNT(*) AS count FROM local_files WHERE COALESCE(json_extract(data, ?), 0) = 0")
        .get("$.folder")
      db.close()
      return count
    })
    const knownFiles = storeCounts.reduce((total, count) => total + count, 0)
    console.log(knownFiles)
  ' "$@"
}

# "Content" is a regular file that sync could have delivered: a file at
# any depth whose path has no dot-named component, or any file under
# .obsidian/ (synced settings and plugin data). Dotfiles elsewhere are not
# synced and do not count. `ob sync` itself creates .obsidian/ and a
# .sync.lock directory in it before transferring anything
# (obsidian-headless cli.js), so that directory is skipped.
#
# Directories alone are not content: a wipe that deletes files but leaves
# the folder tree in place (`find -type f -delete`, a restore that kept
# empty directories) must still read as an empty vault, or the guard would
# let the engine push every recorded file as a deletion.
vault_has_content() {
  find "$VAULT_PATH" -mindepth 1 \
    \( -path "$VAULT_PATH/.obsidian/.sync.lock" -prune \) -o \
    \( -name '.*' ! -path "$VAULT_PATH/.obsidian" ! -path "$VAULT_PATH/.obsidian/*" -prune \) -o \
    -type f -print | grep -q .
}

if ! KNOWN_SYNC_FILES=$(known_sync_files); then
  echo "[obsidian-sync] ERROR: Could not read this device's sync state under ${SYNC_STATE_ROOT}." >&2
  echo "[obsidian-sync] Refusing to sync without knowing which files this device has already synced." >&2
  exit 1
fi

if [ "$KNOWN_SYNC_FILES" -gt 0 ] && ! vault_has_content; then
  echo "[obsidian-sync] ERROR: The vault is empty but this device has previously synced." >&2
  echo "[obsidian-sync] Starting sync in this state would cause the sync engine to interpret" >&2
  echo "[obsidian-sync] every previously-synced file as a local deletion, pushing mass" >&2
  echo "[obsidian-sync] deletions to all connected devices." >&2
  echo "[obsidian-sync] To restore the vault: re-attach the vault volume or restore from backup." >&2
  echo "[obsidian-sync] If you emptied the vault on purpose, this stop is expected." >&2
  echo "[obsidian-sync] Re-register the device as below. A fresh device downloads the empty vault without deleting anything." >&2
  echo "[obsidian-sync] To start fresh: remove the Obsidian config directory (${XDG_CONFIG_HOME:-$HOME/.config} — the obsidian_config volume under Compose, or the config directory under STORAGE_ROOT) to re-register the device." >&2
  exit 1
fi

# Sync is always configured here — init-setup-vault requires VAULT_NAME and
# has just written the Sync client's settings for this vault, so a missing or
# unreadable config means the client can't read its own state either. The
# vault ID in those settings names the store the client syncs from. Any other
# store under SYNC_STATE_ROOT belongs to an earlier registration.
if ! SYNC_CONFIG_JSON=$(s6-setuidgid obsidian ob sync-config --json); then
  echo "[obsidian-sync] ERROR: Could not read this vault's Sync settings (ob sync-config --json failed)." >&2
  exit 1
fi

# Prints one string field of SYNC_CONFIG_JSON. Exits non-zero when the JSON
# doesn't parse or the field is missing or empty.
sync_config_field() {
  node --no-warnings -e '
    const parseConfig = (configText) => {
      try {
        return JSON.parse(configText)
      } catch {
        process.exit(1)
      }
    }
    const value = parseConfig(process.argv[1])?.[process.argv[2]]
    if (typeof value !== "string" || value === "") {
      process.exit(1)
    }
    console.log(value)
  ' "$SYNC_CONFIG_JSON" "$1"
}

if ! SYNC_VAULT_ID=$(sync_config_field vaultId) || ! SYNC_MODE_IN_EFFECT=$(sync_config_field syncMode); then
  echo "[obsidian-sync] ERROR: This vault's Sync settings have no vault ID or sync mode." >&2
  exit 1
fi
ACTIVE_SYNC_STATE="$SYNC_STATE_ROOT/$SYNC_VAULT_ID/state.db"

# Queues every server_files row that has no local_files row, and prints how
# many rows it added. The "Never-downloaded files" note at the top of this
# file says why. The queued row is the server_files data verbatim, the same
# row the engine writes when a filter change queues a file. A path that
# already has a queued entry is left alone, because that entry may be a
# newer version.
queue_never_downloaded_files() {
  # A device that has never synced has no store yet, so nothing to queue.
  [ -e "$ACTIVE_SYNC_STATE" ] || { echo 0; return 0; }

  # As the obsidian user, so any SQLite journal files stay writable by the
  # Sync client.
  # shellcheck disable=SC2016 # the JavaScript's ${table}, "$.uid" and "$.deleted" must reach node unexpanded
  s6-setuidgid obsidian node --no-warnings -e '
    const { DatabaseSync } = require("node:sqlite")
    const db = new DatabaseSync(process.argv[1])
    // An unrecognized table layout exits non-zero, so a Sync client upgrade
    // cannot turn this step into a silent no-op.
    const requiredColumns = {
      pending_files: ["uid", "path", "data"],
      server_files: ["path", "data"],
      local_files: ["path", "data"],
    }
    for (const [table, columns] of Object.entries(requiredColumns)) {
      const presentColumns = db
        .prepare("SELECT name FROM pragma_table_info(?)")
        .all(table)
        .map((column) => column.name)
      const missingColumns = columns.filter((column) => !presentColumns.includes(column))
      if (missingColumns.length > 0) {
        console.error(`${table} has no ${missingColumns.join(", ")} column`)
        process.exit(1)
      }
    }
    db.exec("BEGIN IMMEDIATE")
    // OR IGNORE skips a row whose uid is already queued (uid is the PK);
    // NOT EXISTS skips a path with an existing queued entry (may be a newer
    // version). Both are needed: uid dedupes by identity, path by location.
    const { changes } = db
      .prepare(`
        INSERT OR IGNORE INTO pending_files (uid, path, data)
        SELECT json_extract(server.data, ?), server.path, server.data
        FROM server_files AS server
        LEFT JOIN local_files AS local ON local.path = server.path
        WHERE local.path IS NULL
          AND COALESCE(json_extract(server.data, ?), 0) = 0
          AND NOT EXISTS (SELECT 1 FROM pending_files AS queued WHERE queued.path = server.path)
      `)
      // Positional params: first ? → $.uid (the SELECT), second ? → $.deleted (the WHERE)
      .run("$.uid", "$.deleted")
    db.exec("COMMIT")
    db.close()
    console.log(changes)
  ' "$ACTIVE_SYNC_STATE"
}

# Runs queue_never_downloaded_files and exits the script when it fails:
# syncing without that step could delete files this device never had.
queue_never_downloaded_files_or_exit() {
  if ! QUEUED_FILES=$(queue_never_downloaded_files); then
    echo "[obsidian-sync] ERROR: Could not queue the files this device has not downloaded yet (${ACTIVE_SYNC_STATE})." >&2
    echo "[obsidian-sync] Refusing to sync: without that step, a sync could delete those files from Obsidian Sync and your other devices." >&2
    exit 1
  fi
  if [ "$QUEUED_FILES" -gt 0 ]; then
    echo "[obsidian-sync] Queued ${QUEUED_FILES} file(s) this device has not downloaded yet."
  fi
}

# Prints how many paths are still queued for download and not marked deleted
# on the server. Folders count too, because the deletion scan can remove a
# remote folder the same way. Local records are ignored: a record can outlive
# its file when the engine's startup scan fails, so excluding recorded paths
# could hide a file the scan would still delete.
queued_downloads_remaining() {
  [ -e "$ACTIVE_SYNC_STATE" ] || { echo 0; return 0; }
  s6-setuidgid obsidian node --no-warnings -e '
    const { DatabaseSync } = require("node:sqlite")
    const db = new DatabaseSync(process.argv[1], { readOnly: true })
    const { count } = db
      .prepare(`
        SELECT COUNT(DISTINCT pending.path) AS count
        FROM pending_files AS pending
        JOIN server_files AS server ON server.path = pending.path
        WHERE COALESCE(json_extract(server.data, ?), 0) = 0
      `)
      .get("$.deleted")
    db.close()
    console.log(count)
  ' "$ACTIVE_SYNC_STATE"
}

# Mirrors how config.ts reads these two settings — keep them in lockstep:
# - MEMORY_DIR: whitespace trimmed; empty or whitespace-only means "About Me".
# - MEMORY_ENABLED: case-insensitive, default true; "false" or "0" turns it
#   off (env-var's asBool).
MEMORY_DIR=$(printf '%s' "${MEMORY_DIR:-}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
MEMORY_DIR="${MEMORY_DIR:-About Me}"
MEMORY_ENABLED=$(printf '%s' "${MEMORY_ENABLED:-true}" | tr '[:upper:]' '[:lower:]')
MEMORY_IS_ENABLED=true
if [ "$MEMORY_ENABLED" = "false" ] || [ "$MEMORY_ENABLED" = "0" ]; then
  MEMORY_IS_ENABLED=false
fi

MAX_ATTEMPTS=3

ATTEMPT=1
while :; do
  queue_never_downloaded_files_or_exit
  echo "[obsidian-sync] First sync (attempt ${ATTEMPT}/${MAX_ATTEMPTS}) — waiting for completion before starting services..."
  if s6-setuidgid obsidian ob sync; then
    echo "[obsidian-sync] First sync complete."
    exit 0
  fi
  if [ "$ATTEMPT" -ge "$MAX_ATTEMPTS" ]; then
    break
  fi
  ATTEMPT=$((ATTEMPT + 1))
  echo "[obsidian-sync] First sync failed — retrying in 10s..." >&2
  sleep 10
done

# Queued once more after the last attempt. When the engine skips a queued
# entry because a newer version of the file arrived, it deletes every queued
# entry for that path. If the newer download then fails, the file is left
# unqueued, and the count below would miss it.
queue_never_downloaded_files_or_exit
if ! QUEUED_DOWNLOADS=$(queued_downloads_remaining); then
  echo "[obsidian-sync] ERROR: Could not read this device's sync state (${ACTIVE_SYNC_STATE})." >&2
  exit 1
fi
if [ "$SYNC_MODE_IN_EFFECT" = "bidirectional" ] && [ "$QUEUED_DOWNLOADS" -gt 0 ]; then
  echo "[obsidian-sync] ERROR: First sync failed with ${QUEUED_DOWNLOADS} file(s) still waiting to download." >&2
  echo "[obsidian-sync] Refusing to start two-way sync: it could delete those files from Obsidian Sync and your other devices." >&2
  echo "[obsidian-sync] The count may include files excluded by SYNC_FILE_TYPES, SYNC_EXCLUDED_FOLDERS, or SYNC_CONFIGS — those are dropped from the queue during a successful sync." >&2
  echo "[obsidian-sync] Check the network, your Obsidian Sync login, and the log above for a file that keeps failing to download — the container's restart policy retries." >&2
  echo "[obsidian-sync] To start the server while the downloads retry, set SYNC_MODE=pull-only — it never deletes anything from Obsidian Sync." >&2
  exit 1
fi

# Checked at decision time, not before the attempts: a failed sync may still
# have delivered the memory folder, and a partially delivered folder already
# defuses the bootstrap (it only writes templates when the folder is absent).
# Two-way sync only: pull-only and mirror-remote never upload, and the real
# memory files overwrite the templates once they arrive.
if [ "$SYNC_MODE_IN_EFFECT" = "bidirectional" ] && [ "$MEMORY_IS_ENABLED" = "true" ] && [ ! -d "$VAULT_PATH/$MEMORY_DIR" ]; then
  echo "[obsidian-sync] ERROR: First sync failed and the memory folder ('$MEMORY_DIR') has not synced yet." >&2
  echo "[obsidian-sync] Refusing to start: the MCP server would create memory template files" >&2
  echo "[obsidian-sync] that sync could push over your real notes once it recovers." >&2
  echo "[obsidian-sync] Check the network and your Obsidian Sync login — the container's restart policy retries." >&2
  exit 1
fi

echo "[obsidian-sync] WARNING: First sync did not complete — starting services anyway." >&2
echo "[obsidian-sync] Continuous sync will keep retrying; check the network and your Obsidian Sync login if this persists." >&2
exit 0
