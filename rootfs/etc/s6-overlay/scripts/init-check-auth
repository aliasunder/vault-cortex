#!/command/with-contenv sh
# Init-chain gate: decide where the Obsidian Sync auth token comes from.
# Precedence mirrors the Sync client's own lookup (OBSIDIAN_AUTH_TOKEN, then
# its credential file): env var → token file on the config volume → neither.
#
# With neither, publishes SETUP_MODE=1 so the boot serves the /setup sign-in
# page instead of stopping.
set -eu

# Published the way init-derive-env publishes derived vars: every later
# with-contenv stage reads /run/s6/container_environment/SETUP_MODE when it
# starts. The directory is overridable only so the script tests can run
# this file under plain `sh`.
CONTAINER_ENVIRONMENT_DIR="${CONTAINER_ENVIRONMENT_DIR:-/run/s6/container_environment}"

# s6-overlay copies the container's outside environment into that directory
# at init, so a SETUP_MODE or SETUP_REASON set in a deployment's settings
# would be honoured by every later stage. Both are this chain's own
# findings, decided below and by init-obsidian-login — never an input.
rm -f "$CONTAINER_ENVIRONMENT_DIR/SETUP_MODE" "$CONTAINER_ENVIRONMENT_DIR/SETUP_REASON"

# Presence is decided on the value without whitespace: a variable holding
# only a space (a placeholder left in a template) is no token, and would
# otherwise skip setup mode and stop the boot at `ob login`.
if [ -n "$(printf '%s' "${OBSIDIAN_AUTH_TOKEN:-}" | tr -d '[:space:]')" ]; then
  echo "[obsidian-sync] Auth token present."
  exit 0
fi

# The Sync client's credential file — what `ob login` writes and what the
# /setup page writes in its place.
TOKEN_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/obsidian-headless/auth_token"
if [ -s "$TOKEN_FILE" ]; then
  echo "[obsidian-sync] Auth token found on the volume."
  exit 0
fi

printf '%s' 1 > "$CONTAINER_ENVIRONMENT_DIR/SETUP_MODE"
echo "[vault-cortex] No Obsidian Sync token yet — starting in setup mode."
echo "[vault-cortex] Sign in at ${PUBLIC_URL:-http://<your-server>:${PORT:-8000}}/setup — you will need your MCP_AUTH_TOKEN."
