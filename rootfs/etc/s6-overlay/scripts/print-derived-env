#!/bin/sh
# Prints the env vars the remote image derives at boot, one NAME=value per
# line on stdout, for init-derive-env to publish to the later s6 stages.
# Pure — reads the environment, writes nothing — so the derivation is
# unit-testable by running this file under `sh`.
#
# A var is derived when it is unset OR empty — the same rule the server
# applies to every optional setting (config.ts trims and falls back on
# empty), and what Compose's `${VAR:-}` passthrough produces for a blank
# .env entry. A non-empty value is always kept.
#
# STORAGE_ROOT unset — the Compose / VPS layout with three mounts:
# VAULT_PATH and INDEX_DB_PATH take the image's historical defaults;
# XDG_CONFIG_HOME is left alone (obsidian-headless falls back to
# $HOME/.config).
#
# STORAGE_ROOT set — container hosting platforms that allow a single
# persistent mount (Railway, Render): the vault, the index, log files,
# and Obsidian Sync state all live under it, so one volume carries
# everything that must survive a redeploy. LOG_DIR defaults to
# $STORAGE_ROOT/data/logs (matching the remote Compose file's default-on
# behavior); LOG_DIR=none turns log files off.
set -eu

# find -path treats *, ?, and [ as wildcards — a path containing them
# makes the deletion-storm guard's patterns silently malfunction.
contains_glob_chars() {
  case "$1" in
    *\** | *\?* | *\[*) return 0 ;;
    *) return 1 ;;
  esac
}

if [ -z "${STORAGE_ROOT:-}" ]; then
  if [ -z "${VAULT_PATH:-}" ]; then
    printf 'VAULT_PATH=%s\n' /vault
  fi
  if [ -z "${INDEX_DB_PATH:-}" ]; then
    printf 'INDEX_DB_PATH=%s\n' /data/index.db
  fi
else
  # Normalize so "/persist/", "/persist//" and "/persist" derive the same
  # paths: collapse runs of slashes, then drop trailing ones.
  storage_root=$(printf '%s' "$STORAGE_ROOT" | sed 's://*:/:g; s:/*$::')
  # Refuse every form that resolves to the filesystem root ("/", "//", "/.",
  # "/..") and any relative or dot-segment path: the derived /config and
  # /data/logs would sit on the container's ephemeral layer, not on a mount,
  # so Sync device state and the deletion-storm sentinel would vanish on the
  # next recreation. The check is lexical — whether the directory is actually
  # a mount is the operator's contract.
  case "$storage_root" in
    /?*) storage_root_is_usable=true ;;
    *) storage_root_is_usable=false ;;
  esac
  case "$storage_root" in
    /. | /.. | */./* | */../* | */. | */..) storage_root_is_usable=false ;;
  esac
  if [ "$storage_root_is_usable" != true ]; then
    echo "[vault-cortex] ERROR: STORAGE_ROOT must be an absolute path to a directory inside a persistent mount (e.g. /persist), not '$STORAGE_ROOT'." >&2
    exit 1
  fi
  if contains_glob_chars "$storage_root"; then
    echo "[vault-cortex] ERROR: STORAGE_ROOT must not contain glob characters (*, ?, [) — they break the container's find-path safety guards, not '$STORAGE_ROOT'." >&2
    exit 1
  fi
  if [ -z "${VAULT_PATH:-}" ]; then
    printf 'VAULT_PATH=%s\n' "$storage_root/vault"
  fi
  if [ -z "${INDEX_DB_PATH:-}" ]; then
    printf 'INDEX_DB_PATH=%s\n' "$storage_root/data/index.db"
  fi
  if [ -z "${LOG_DIR:-}" ]; then
    printf 'LOG_DIR=%s\n' "$storage_root/data/logs"
  fi
  # XDG_CONFIG_HOME is the XDG Base Directory variable that tells programs
  # where per-user config lives; unset or empty means $HOME/.config
  # (https://specifications.freedesktop.org/basedir-spec/latest/).
  # obsidian-headless keeps its Sync login and device registration under
  # $XDG_CONFIG_HOME/obsidian-headless/ — /persist/config/obsidian-headless/
  # here, versus /home/obsidian/.config/obsidian-headless/ on the three-volume
  # layout — so pointing it into the volume is what makes Sync state survive
  # a container re-creation.
  if [ -z "${XDG_CONFIG_HOME:-}" ]; then
    printf 'XDG_CONFIG_HOME=%s\n' "$storage_root/config"
  fi
fi

# An explicit VAULT_PATH bypasses derivation — check it for glob chars.
# Derived values are safe: they append "/vault" to a validated storage_root.
if [ -n "${VAULT_PATH:-}" ] && contains_glob_chars "$VAULT_PATH"; then
  echo "[vault-cortex] ERROR: VAULT_PATH must not contain glob characters (*, ?, [) — they break the container's find-path safety guards, not '$VAULT_PATH'." >&2
  exit 1
fi

# The server requires PUBLIC_URL. Each hosted platform exposes the service's
# public address under its own variable, so check them in order and build
# PUBLIC_URL from the first one that is set — a template deploy then boots
# without the user hand-typing a URL the platform only assigns at creation.
# A non-empty PUBLIC_URL always wins; when no platform variable is set,
# PUBLIC_URL stays unset so the server's required-variable error still fires.
if [ -z "${PUBLIC_URL:-}" ]; then
  if [ -n "${RENDER_EXTERNAL_URL:-}" ]; then
    printf 'PUBLIC_URL=%s\n' "$RENDER_EXTERNAL_URL"
    echo "[vault-cortex] PUBLIC_URL derived from RENDER_EXTERNAL_URL" >&2
  elif [ -n "${RAILWAY_PUBLIC_DOMAIN:-}" ]; then
    printf 'PUBLIC_URL=https://%s\n' "$RAILWAY_PUBLIC_DOMAIN"
    echo "[vault-cortex] PUBLIC_URL derived from RAILWAY_PUBLIC_DOMAIN" >&2
  fi
fi
