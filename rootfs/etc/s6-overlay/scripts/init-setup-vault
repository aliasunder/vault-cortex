#!/command/with-contenv sh
# shellcheck shell=sh # ShellCheck cannot read the with-contenv shebang
# Set up the vault and apply optional sync configuration.
# All ob commands run as the obsidian user via s6-setuidgid.
set -e

if [ "${SETUP_MODE:-}" = 1 ]; then
  echo "[obsidian-sync] Setup mode — skipping vault setup."
  exit 0
fi

VAULT_PATH="${VAULT_PATH:-/vault}"
mkdir -p "$VAULT_PATH"
if ! cd "$VAULT_PATH"; then
  echo "[obsidian-sync] ERROR: Failed to change directory to VAULT_PATH='$VAULT_PATH'." >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# First-time vault setup
# ---------------------------------------------------------------------------

# Passes --device-name on the first registration, because without it the CLI
# names the device after the container hostname and every re-created
# container adds a new Obsidian Sync device. "$@" carries the caller's flags
# and "$DEVICE_NAME" is quoted, so a vault or device name with spaces stays
# one argument.
run_sync_setup() {
  if [ -n "$DEVICE_NAME" ]; then
    s6-setuidgid obsidian ob sync-setup "$@" --device-name "$DEVICE_NAME"
  else
    s6-setuidgid obsidian ob sync-setup "$@"
  fi
}

# VAULT_NAME is required: Obsidian Sync needs a vault to sync, and a boot
# without one would reach the first-sync stage unconfigured. Compose enforces
# this via `:?`; plain `docker run` and hosting-platform settings pages do
# not, so the check lives here too.
if [ -z "$VAULT_NAME" ]; then
  echo "[obsidian-sync] ERROR: VAULT_NAME is not set." >&2
  echo "[obsidian-sync] Set VAULT_NAME to your exact Obsidian vault name (case-sensitive) in .env (or -e VAULT_NAME=...) and restart." >&2
  exit 1
fi

echo "[obsidian-sync] Configuring sync for vault: '$VAULT_NAME' → $VAULT_PATH"
# run_sync_setup prepends `ob sync-setup`, so $@ holds flags only.
set -- --vault "$VAULT_NAME"
if [ -n "$VAULT_PASSWORD" ]; then
  set -- "$@" --password "$VAULT_PASSWORD"
fi
if [ -n "$CONFIG_DIR_NAME" ]; then
  set -- "$@" --config-dir "$CONFIG_DIR_NAME"
fi
if ! run_sync_setup "$@"; then
  echo "[obsidian-sync] ERROR: ob sync-setup failed." >&2
  echo "[obsidian-sync] Check OBSIDIAN_AUTH_TOKEN and VAULT_NAME are correct." >&2
  if [ -z "$VAULT_PASSWORD" ]; then
    echo "[obsidian-sync] If your vault uses end-to-end encryption, set VAULT_PASSWORD." >&2
  fi
  exit 1
fi

# ---------------------------------------------------------------------------
# Apply optional sync config
# ---------------------------------------------------------------------------

# Optional config other than the sync mode (below) stays non-fatal: a bad
# value must not stop the container. Failures are still logged with the
# CLI's stderr so a typo'd value (e.g. an invalid CONFLICT_STRATEGY via
# plain `docker run`, where Compose defaults don't apply) leaves a trace
# in `docker logs` instead of vanishing.
apply_sync_config() {
  flag="$1"
  value="$2"
  if [ -z "$value" ]; then
    return 0
  fi
  if ! s6-setuidgid obsidian ob sync-config "$flag" "$value"; then
    echo "[obsidian-sync] WARNING: ob sync-config $flag '$value' failed — continuing without it." >&2
  fi
}

# These settings are always applied, even when empty: an empty argument is
# the Sync client's "clear" form (`ob sync-config --help`). `ob sync-setup`
# above already drops them on every boot, so today an empty call changes
# nothing. It stays so a Sync client version that keeps them across
# `sync-setup` still can't hold on to a folder exclusion or attachment
# filter the user has cleared.
apply_sync_config_or_clear() {
  flag="$1"
  value="$2"
  if ! s6-setuidgid obsidian ob sync-config "$flag" "$value"; then
    echo "[obsidian-sync] WARNING: ob sync-config $flag '$value' failed — continuing without it." >&2
  fi
}

apply_sync_config --device-name "$DEVICE_NAME"
apply_sync_config --conflict-strategy "$CONFLICT_STRATEGY"
apply_sync_config_or_clear --excluded-folders "${SYNC_EXCLUDED_FOLDERS:-}"
apply_sync_config_or_clear --file-types "${SYNC_FILE_TYPES:-}"

# A sync mode that fails to apply stops the container. `ob sync-setup` has
# just reset the stored mode to two-way, so continuing would sync two-way
# against an explicit pull-only or mirror-remote request and upload changes
# the user chose not to send. The usual cause is an invalid value, and the
# CLI's message on stderr names the valid ones.
if [ -n "$SYNC_MODE" ] && ! s6-setuidgid obsidian ob sync-config --mode "$SYNC_MODE"; then
  echo "[obsidian-sync] ERROR: ob sync-config --mode '$SYNC_MODE' failed." >&2
  echo "[obsidian-sync] Refusing to start: syncing in a different mode than SYNC_MODE requests could upload changes you chose not to send." >&2
  echo "[obsidian-sync] Set SYNC_MODE to bidirectional, pull-only, or mirror-remote and restart." >&2
  exit 1
fi

# Obsidian settings categories to sync into .obsidian/:
# - Default: the two the server reads — core-plugin-data (daily notes
#   settings) and community-plugin-data (community plugin settings, such as
#   the Tasks plugin's format). Applied here as well as in the compose files,
#   so plain `docker run` matches.
# - SYNC_CONFIGS=none: sends an empty value, the client's "clear" form
#   (`ob sync-config --help`). Skipping the call would leave the client's own
#   defaults syncing, since `ob sync-setup` above resets this setting to them
#   on every boot: app, appearance, appearance-data, hotkey, core-plugin, and
#   core-plugin-data.
if [ "$SYNC_CONFIGS" = "none" ]; then
  if ! s6-setuidgid obsidian ob sync-config --configs ""; then
    echo "[obsidian-sync] WARNING: ob sync-config --configs '' failed — continuing without it." >&2
  fi
else
  apply_sync_config --configs "${SYNC_CONFIGS:-core-plugin-data,community-plugin-data}"
fi
