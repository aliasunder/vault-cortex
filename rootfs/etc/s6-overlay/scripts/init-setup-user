#!/command/with-contenv sh
# Adjust the obsidian user/group UID/GID to match PUID/PGID env vars.
set -e

PUID="${PUID:-1000}"
PGID="${PGID:-1000}"
VAULT_PATH="${VAULT_PATH:-/vault}"
# obsidian-headless keeps its config under $XDG_CONFIG_HOME (falling back to
# $HOME/.config); single-volume mode (STORAGE_ROOT) relocates it, the
# three-volume layout leaves it unset and resolves to /home/obsidian/.config.
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
# The index directory is INDEX_DB_PATH's parent — the same derivation the
# server applies (server.ts); keep the two in lockstep.
DATA_DIR="${INDEX_DB_PATH:-/data/index.db}"
DATA_DIR="${DATA_DIR%/*}"
# Records the last PUID:PGID whose recursive chown completed. Lives in the
# config directory so it survives container recreation — comparing against
# the image-baked passwd entry instead (always 1000 on a fresh container)
# would miss a PUID change back to 1000 and strand volume contents at the
# old IDs.
APPLIED_IDS_FILE="$CONFIG_HOME/.applied-ids"

CURRENT_UID=$(id -u obsidian)
CURRENT_GID=$(id -g obsidian)

if [ "$PGID" != "$CURRENT_GID" ]; then
  echo "[obsidian-sync] Adjusting obsidian group GID: ${CURRENT_GID} → ${PGID}"
  groupmod -o -g "$PGID" obsidian
fi

if [ "$PUID" != "$CURRENT_UID" ]; then
  echo "[obsidian-sync] Adjusting obsidian user UID: ${CURRENT_UID} → ${PUID}"
  usermod -o -u "$PUID" obsidian
fi

# Ensure the vault, index, and config directories exist.
# The index directory (INDEX_DB_PATH's parent) must follow PUID/PGID
# alongside the vault so svc-vault-mcp can write the search index.
mkdir -p "$VAULT_PATH" "$DATA_DIR" "$CONFIG_HOME"

APPLIED_IDS=$(cat "$APPLIED_IDS_FILE" 2>/dev/null || true)
if [ "$APPLIED_IDS" != "${PUID}:${PGID}" ]; then
  # Recursive chown whenever the recorded IDs don't match — covers first boot
  # (no record; volumes are near-empty so this is cheap) and any later
  # PUID/PGID change in either direction so existing volume contents stay
  # accessible.
  echo "[obsidian-sync] Ownership IDs changed (${APPLIED_IDS:-unrecorded} → ${PUID}:${PGID}) — fixing ownership recursively..."
  chown -R "$PUID:$PGID" /home/obsidian "$VAULT_PATH" "$DATA_DIR" "$CONFIG_HOME"
  echo "${PUID}:${PGID}" > "$APPLIED_IDS_FILE"
  chown "$PUID:$PGID" "$APPLIED_IDS_FILE"
else
  # Just fix top-level ownership (fast — catches fresh mountpoints created by root)
  chown "$PUID:$PGID" /home/obsidian "$VAULT_PATH" "$DATA_DIR" "$CONFIG_HOME"
fi

echo "[obsidian-sync] Running as UID=${PUID} GID=${PGID}"
