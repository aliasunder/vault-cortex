#!/usr/bin/env bash
# Fake docker binary for CLI PTY integration tests.
# Shadows the real docker when its directory is prepended to PATH.
# Behavior is controllable via environment variables:
#   DOCKER_SHIM_PRESENT         — space-separated container and volume names that
#                                 exist; `container ls` lists them, and
#                                 `container inspect` and `volume inspect`
#                                 exit 1 for any other name (default: none exist)
#   DOCKER_SHIM_IMAGE           — the image `container inspect` reports for a
#                                 present container (default: the local image)
#   DOCKER_SHIM_RUN_FAIL=1      — `run` exits 1
#   DOCKER_SHIM_HEALTH_PORT     — port for the background health server (default 8000)
#   DOCKER_SHIM_PID_FILE        — where to write the health server PID

set -euo pipefail

# Exits 0 when the name is in DOCKER_SHIM_PRESENT.
is_present() {
  case " ${DOCKER_SHIM_PRESENT:-} " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

case "${1:-}" in
  info)
    echo '{"ServerVersion":"27.0.0","OSType":"linux"}'
    ;;

  run)
    if [ "${DOCKER_SHIM_RUN_FAIL:-}" = "1" ]; then
      exit 1
    fi
    # Start a background HTTP server that responds 200 to /healthz.
    # Port and PID file path are read via process.env to avoid
    # bash interpolation breaking on paths with special characters.
    DOCKER_SHIM_HEALTH_PORT="${DOCKER_SHIM_HEALTH_PORT:-8000}" \
    DOCKER_SHIM_PID_FILE="${DOCKER_SHIM_PID_FILE:-/tmp/docker-shim-health.pid}" \
    node -e '
      const s = require("http").createServer((q, r) => {
        r.writeHead(200, {"Content-Type":"text/plain"});
        r.end("ok");
      });
      s.listen(Number(process.env.DOCKER_SHIM_HEALTH_PORT), "127.0.0.1", () => {
        require("fs").writeFileSync(process.env.DOCKER_SHIM_PID_FILE, String(process.pid));
      });
    ' &
    ;;

  container)
    # docker container ls -aq — one line per present name, standing in for the
    # container IDs; the inspect below prints no ports for them
    if [ "${2:-}" = "ls" ]; then
      for present_name in ${DOCKER_SHIM_PRESENT:-}; do
        echo "$present_name"
      done
      exit 0
    fi
    # docker container inspect --format <format> <name>... — one line per present
    # container: its name with Docker's leading slash, then its image when the
    # format asks for it. Like docker, exits 1 when any name is missing, after
    # printing the others.
    inspect_status=0
    for container_name in "${@:5}"; do
      if ! is_present "$container_name"; then
        inspect_status=1
        continue
      fi
      case "${4:-}" in
        *.Config.Image*)
          echo "/$container_name ${DOCKER_SHIM_IMAGE:-ghcr.io/aliasunder/vault-cortex:latest}"
          ;;
        *)
          echo "/$container_name"
          ;;
      esac
    done
    exit "$inspect_status"
    ;;

  volume)
    # docker volume inspect <name> — check if volume exists
    if ! is_present "${3:-}"; then
      exit 1
    fi
    echo '[{"Name":"'"${3:-}"'"}]'
    ;;

  stop)
    PID_FILE="${DOCKER_SHIM_PID_FILE:-/tmp/docker-shim-health.pid}"
    if [ -f "$PID_FILE" ]; then
      kill "$(cat "$PID_FILE")" 2>/dev/null || true
      rm -f "$PID_FILE"
    fi
    ;;

  rm)
    PID_FILE="${DOCKER_SHIM_PID_FILE:-/tmp/docker-shim-health.pid}"
    if [ -f "$PID_FILE" ]; then
      kill "$(cat "$PID_FILE")" 2>/dev/null || true
      rm -f "$PID_FILE"
    fi
    ;;

  pull)
    echo "Status: Image is up to date"
    ;;

  logs)
    echo '{"timestamp":"2026-01-01T00:00:00Z","level":"info","message":"server started"}'
    ;;

  *)
    echo "docker-shim: unhandled subcommand '$1'" >&2
    exit 1
    ;;
esac
